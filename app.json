{
  "expo": {
    "name": "Degen Tracker",
    "slug": "degen-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/degen-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#11121b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chrisozs77.degentracker",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "splash": {
      "image": "./assets/degen-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#11121b"
    },
    "web": {
      "favicon": "./assets/degen-favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      ["expo-audio", {
        "microphonePermission": false,
        "recordAudioAndroid": false,
        "enableBackgroundRecording": false,
        "enableBackgroundPlayback": false
      }]
    ]
  }
}
